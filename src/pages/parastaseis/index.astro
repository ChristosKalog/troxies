---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShowList from '../../components/ShowList.astro';

const shows = (await getCollection('parastaseis')).sort((a, b) => b.data.order - a.data.order);
---

<Base title="Παραστάσεις" description="Όλες οι παραστάσεις της Εταιρείας Θεάτρου Τροχιές.">
  <section class="section">
    <div class="wrap">
      <header class="head">
        <h1><span class="reveal-line"><span>Παραστάσεις</span></span></h1>
        <p class="meta">{shows.length} δουλειές από το 2023, από την πιο πρόσφατη</p>
      </header>
      <ShowList shows={shows} />
    </div>
  </section>
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; margin-bottom: var(--space-l); }
  h1 { font-size: var(--step-5); line-height: 0.9; }
</style>

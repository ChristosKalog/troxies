---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Orbits from '../components/Orbits.astro';
import ShowList from '../components/ShowList.astro';
import Media from '../components/Media.astro';
import RingLink from '../components/RingLink.astro';
import { site } from '../site.config';
import { formatRange, isPast } from '../lib/format';

const shows = (await getCollection('parastaseis')).sort((a, b) => b.data.order - a.data.order);
const latest = shows[0];
const dates = latest.data.dates ?? [];
const upcoming = dates.filter((d) => !isPast(d));
const shownDates = upcoming.length ? upcoming : dates.slice(-2);
---

<Base>
  <section class="hero" data-orbit-host>
    <div class="hero-orbits">
      <Orbits count={6} seed="hero" title="Έξι τροχιές γύρω από έναν κοινό πυρήνα" />
    </div>
    <div class="wrap hero-text">
      <h1 class="wordmark" aria-label="Τροχιές">
        <span class="reveal-line"><span style="--i:0">τροχιές</span></span>
      </h1>
      <p class="hero-sub">
        <span class="reveal-line"><span style="--i:3">Εταιρεία θεάτρου από τη Θεσσαλονίκη.</span></span>
        <span class="reveal-line"><span style="--i:4">Παραστάσεις που γεννιούνται από συλλογική έρευνα.</span></span>
      </p>
    </div>
    <p class="hint meta" aria-hidden="true">Κούνησε τον δείκτη για να γείρεις τις τροχιές. Κάνε κλικ για ώθηση.</p>
  </section>

  <section class="section latest">
    <div class="wrap latest-grid">
      <a class="latest-media" href={`/parastaseis/${latest.id}/`} tabindex="-1" aria-hidden="true">
        <Media src={latest.data.cover} seed={latest.id} ratio="5 / 6" label="Εδώ θα μπει φωτογραφία από την παράσταση" />
      </a>
      <div class="latest-text">
        <p class="meta">{upcoming.length ? 'Επόμενες παραστάσεις' : 'Η πιο πρόσφατη δουλειά μας'}</p>
        <h2 class="serif latest-title">
          <a href={`/parastaseis/${latest.id}/`}>{latest.data.title}</a>
        </h2>
        <p>{latest.data.summary}</p>
        {shownDates.length > 0 && (
          <ul role="list" class="dates">
            {shownDates.map((d) => (
              <li class:list={{ past: isPast(d) }}>
                <span>{d.city}</span>
                <span class="meta">{d.venue}</span>
                <span>{formatRange(d)}</span>
              </li>
            ))}
          </ul>
        )}
        <RingLink href={`/parastaseis/${latest.id}/`}>Δες την παράσταση</RingLink>
      </div>
    </div>
  </section>

  <section class="section statement">
    <div class="wrap statement-grid">
      <p class="statement-text">
        Ξεκινάμε πάντα από ένα ερώτημα της πόλης μας. Παίρνουμε συνεντεύξεις, αυτοσχεδιάζουμε, γράφουμε μαζί, και φτιάχνουμε
        θέατρο που ενώνει το πολιτικό με το προσωπικό.
      </p>
      <RingLink href="/omada/" tilt={3}>Γνώρισε την ομάδα</RingLink>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Παραστάσεις</h2>
        <a class="link meta" href="/parastaseis/">Όλες οι παραστάσεις</a>
      </div>
      <ShowList shows={shows} size="m" />
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4.5rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    padding-bottom: var(--space-l);
  }
  .hero-orbits {
    position: absolute;
    width: min(115vh, 100vw);
    right: -6vw;
    top: 50%;
    translate: 0 -52%;
  }
  .hero-text { position: relative; pointer-events: none; }
  .wordmark {
    font-size: clamp(5rem, 22vw, 24rem);
    line-height: 0.82;
    letter-spacing: -0.03em;
    margin-left: -0.04em;
    mix-blend-mode: difference;
    color: #fff;
  }
  .hero-sub { margin-top: var(--space-m); font-size: var(--step-1); font-weight: 300; line-height: 1.35; max-width: 34ch; }
  .hint { position: absolute; right: var(--gutter); bottom: var(--space-m); max-width: 22ch; text-align: right; }
  @media (pointer: coarse), (max-width: 820px) { .hint { display: none; } }

  .latest-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: var(--space-l); align-items: center; }
  .latest-media { display: block; }
  .latest-media :global(.media) {
    clip-path: ellipse(48% 50% at 50% 50%);
    transition: clip-path 0.9s var(--ease-orbit);
  }
  .latest-media:hover :global(.media), .latest-grid:hover .latest-media :global(.media) { clip-path: ellipse(72% 72% at 50% 50%); }
  .latest-text { display: grid; gap: var(--space-m); justify-items: start; }
  .latest-title { font-size: var(--step-4); line-height: 1; }
  .latest-title a { text-decoration: none; }
  .dates { width: 100%; border-top: 1px solid var(--ink); }
  .dates li {
    display: grid; grid-template-columns: 8rem 1fr auto; gap: 1rem; padding-block: 0.7rem;
    border-bottom: 1px solid var(--rule); align-items: baseline;
  }
  .dates li.past { color: var(--ink-soft); }

  .statement-grid { display: grid; gap: var(--space-l); justify-items: start; }
  .statement-text { font-size: var(--step-3); font-weight: 260; line-height: 1.18; letter-spacing: -0.015em; max-width: 24ch; }

  @media (max-width: 820px) {
    .hero-orbits { width: 150vw; right: -45vw; top: 38%; }
    .wordmark { font-size: 27vw; }
    .latest-grid { grid-template-columns: 1fr; }
    .dates li { grid-template-columns: 1fr auto; }
    .dates li .meta { grid-column: 1 / -1; grid-row: 2; }
  }
</style>

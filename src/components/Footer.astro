---
import { site } from '../site.config';
import OrbitPattern from './OrbitPattern.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="bg" aria-hidden="true">
    <OrbitPattern seed="footer" count={7} width={1200} height={420} />
  </div>
  <div class="wrap grid">
    <div>
      <p class="serif name">{site.fullName}</p>
      <p class="meta">{site.city}, από το 2023</p>
    </div>
    <ul role="list" class="links">
      <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
      {site.socials.map((s) => <li><a class="link" href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
    <p class="meta small">© {year} Τροχιές</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: var(--space-l);
    padding-top: clamp(10rem, 22vw, 18rem);
    padding-bottom: var(--space-l);
    background: var(--wash);
    border-top: 1px solid var(--ink);
    overflow: hidden;
    isolation: isolate;
  }
  .bg { position: absolute; inset: 0; z-index: -1; }
  .grid { display: grid; grid-template-columns: 1.4fr 1fr auto; gap: var(--space-m); align-items: end; }
  /* χαρτί πίσω από το κείμενο, ώστε να διαβάζεται πάνω από τις γραμμές */
  .grid > * { background: var(--wash); box-shadow: 0 0 0 0.6rem var(--wash); justify-self: start; }
  .name { font-size: var(--step-2); line-height: 1.1; }
  .links { display: grid; gap: 0.25rem; }
  .small { align-self: end; }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
